# Copy to .env (never commit it) to override demo defaults. Only variables
# actually read by engine/api.py are listed here. No secrets are required:
# the prototype runs fully on synthetic data with no credentials.
# Comma-separated list; "*" allows any origin (no cookies/auth are used).
FRONTEND_ORIGINS=*
# Upper bound for POST /api/analysis n_mc_samples (validated per request).
MAX_MONTE_CARLO_SAMPLES=200
# Default assumed tariff, INR/kWh (per-request override still validated).
DEFAULT_TARIFF_INR_PER_KWH=2.7
